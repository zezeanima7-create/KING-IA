{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "king-ia",
  "main": "worker.js",
  "compatibility_date": "2026-11-07",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
      "head_sampling_rate": 0.1
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 0.1
    }
  }
}